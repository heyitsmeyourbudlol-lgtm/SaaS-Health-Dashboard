# --- Database ---
# Local dev uses SQLite (zero setup). For production, switch the Prisma
# datasource provider to "postgresql" and point this at your Postgres URL.
DATABASE_URL="file:./dev.db"

# --- Encryption ---
# 32-byte key (base64 or hex) used to encrypt integration credentials at rest.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY="dev-only-insecure-key-change-me-000000000000000="

# --- App ---
APP_BASE_URL="http://localhost:3000"
SESSION_SECRET="dev-session-secret-change-me-000000000000000="

# --- Stripe (your own account, for billing agencies later) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
STRIPE_SUCCESS_URL="http://localhost:3000/dashboard"
STRIPE_CANCEL_URL="http://localhost:3000/pricing"

# --- Scheduled sync (Vercel Cron, etc.) ---
# Protect GET /api/cron/sync with: Authorization: Bearer <secret>
CRON_SECRET=""

# --- Demo seed ---
DEMO_ADMIN_PASSWORD="demo1234"
